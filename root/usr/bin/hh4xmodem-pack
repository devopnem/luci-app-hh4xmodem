#!/usr/bin/ucode
// hh4xmodem-pack - Pack protocol CLI wrapper for HH40V/HH41V MDM9207 modem
// Usage: hh4xmodem-pack <method> [params]

'use strict';

import * as pack from 'hh4xmodem.pack';

if (length(ARGV) < 1) {
	printf("Usage: %s <method> [params]\n", ARGV[0] || "hh4xmodem-pack");
	exit(1);
}

let method = ARGV[0];
let params = length(ARGV) >= 2 ? ARGV[1] : '{}';
let r = pack.call_raw(method, params);

if (r.error != null) {
	printf('%J', { error: r.error });
	exit(2);
}

printf('%s', r.raw);
