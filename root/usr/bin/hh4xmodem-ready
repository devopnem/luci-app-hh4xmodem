#!/usr/bin/ucode
// hh4xmodem-ready - answer the modem "system start" poll without shell forks
// Copyright (C) 2026 HH4xModem
// Licensed under the Apache License, Version 2.0.

'use strict';

import * as pack from 'hh4xmodem.pack';

const ACK = '{"ethwan_status":0,"ethlan_status":0}';

while (true) {
	let r = pack.call_raw('ethWanStatus', ACK);
	sleep(r && r.error == null ? 60000 : 5000);
}
