#!/bin/sh
#
# UCI defaults for luci-app-hh4xmodem
#

touch /etc/config/hh4xmodem

uci -q get hh4xmodem.settings >/dev/null || uci set hh4xmodem.settings=settings
uci -q get hh4xmodem.settings.modem_ip >/dev/null || uci set hh4xmodem.settings.modem_ip='192.168.225.1'
uci -q get hh4xmodem.settings.modem_port >/dev/null || uci set hh4xmodem.settings.modem_port='2016'
uci -q get hh4xmodem.settings.at_port >/dev/null || uci set hh4xmodem.settings.at_port='/dev/ttyUSB2'
uci -q get hh4xmodem.settings.refresh_interval >/dev/null || uci set hh4xmodem.settings.refresh_interval='3'
uci commit hh4xmodem

if pidof rpcd >/dev/null 2>&1; then
	/etc/init.d/rpcd reload 2>/dev/null || /etc/init.d/rpcd restart 2>/dev/null
fi

/etc/init.d/hh4xmodem enable 2>/dev/null
/etc/init.d/hh4xmodem start 2>/dev/null

exit 0
